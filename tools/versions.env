# Pinned toolchain and helper versions.
#
# Sourced by CI and by scripts/check-supply-chain.sh so one edit moves every
# consumer. A version that appears in more than one place drifts; a version
# that lives here does not.

# Rust toolchain used for every gate. MSRV is declared separately in
# Cargo.toml (rust-version) and checked against this by check-supply-chain.sh.
BRIDGEVM_RUST_TOOLCHAIN=1.97.0
BRIDGEVM_RUST_MSRV=1.85

# Supply-chain tooling.
BRIDGEVM_CARGO_DENY_VERSION=0.16.3

# Guest driver package provenance. DriverStore hashes, not file names: a
# rebuilt package with the same name is a different driver.
BRIDGEVM_VIOGPU3D_FIXED=viogpu3d.inf_arm64_6435ce2e01767d8f
BRIDGEVM_VIOGPU3D_SHIPPED_12041=viogpu3d.inf_arm64_44e90b7a44a1d335
