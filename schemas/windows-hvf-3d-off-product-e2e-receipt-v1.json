{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridgevm.dev/schemas/windows-hvf-3d-off-product-e2e-receipt-v1.json",
  "title": "BridgeVM Windows-HVF 3D-off product E2E receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "gate_id", "criterion", "tier", "job_id",
    "tested_commit", "commit", "hosted_ci_commit", "campaign_mode",
    "artifact_signing_class", "clean_machine", "ui_frontend_automated",
    "product_model_automated", "three_d_injection", "worker_cleanup_verified",
    "hosted_ci_green", "security_ci_green", "valid", "expected_runs",
    "run_count", "passes", "failures", "elapsed_ms", "failure_code",
    "outcome", "pass", "claim_eligible", "criterion_pass",
    "capability_promotion", "host_model", "macos_version", "started_at",
    "finished_at", "hosted_ci_run_id", "security_ci_run_id",
    "input_manifest_sha256", "app_artifact_sha256", "app_executable_sha256",
    "helper_sha256", "runner_sha256", "firmware_sha256",
    "secure_boot_policy_sha256", "iso_sha256", "installer_source_sha256",
    "bundled_vars_seed_sha256", "final_disk_sha256", "final_vars_sha256",
    "secure_boot_receipt_sha256", "guest_evidence_sha256",
    "artifact_preflight_passes",
    "vm_created_passes", "source_prepared_passes", "windows_installed_passes",
    "secure_boot_provisioned_passes", "first_ready_passes",
    "keyboard_pointer_passes", "clipboard_passes", "folder_share_passes",
    "network_passes", "audio_passes", "first_shutdown_passes",
    "snapshot_restore_passes", "second_ready_passes", "second_shutdown_passes"
  ],
  "$defs": {
    "sha256": {"oneOf": [{"const": "absent"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "count": {"type": "integer", "minimum": 0},
    "publicText": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  },
  "properties": {
    "schema_version": {"const": "bridgevm.windows-hvf-3d-off-product-e2e.v1"},
    "gate_id": {"const": "windows-hvf-3d-off-product-e2e"},
    "criterion": {"const": "A9"},
    "tier": {"const": "t17-windows-hvf-product-e2e"},
    "job_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "tested_commit": {"$ref": "#/$defs/commit"},
    "commit": {"$ref": "#/$defs/commit"},
    "hosted_ci_commit": {"$ref": "#/$defs/commit"},
    "campaign_mode": {"enum": ["pilot", "release"]},
    "artifact_signing_class": {"enum": ["development-ad-hoc", "developer-id-notarized"]},
    "clean_machine": {"type": "boolean"},
    "ui_frontend_automated": {"type": "boolean"},
    "product_model_automated": {"type": "boolean"},
    "three_d_injection": {"const": false},
    "worker_cleanup_verified": {"type": "boolean"},
    "hosted_ci_green": {"type": "boolean"},
    "security_ci_green": {"type": "boolean"},
    "valid": {"type": "boolean"},
    "expected_runs": {"type": "integer", "enum": [1, 3]},
    "run_count": {"$ref": "#/$defs/count"},
    "passes": {"$ref": "#/$defs/count"},
    "failures": {"$ref": "#/$defs/count"},
    "elapsed_ms": {"$ref": "#/$defs/count"},
    "failure_code": {"enum": ["none", "missing-app-artifact", "missing-windows-iso", "missing-guest-payload", "missing-wimlib", "hash-mismatch", "product-model-failed", "installer-failed", "first-boot-failed", "integration-failed", "snapshot-failed", "cleanup-failed", "canceled", "missing-tier-receipt", "internal-error"]},
    "outcome": {"enum": ["completed", "preflight-blocked", "failed", "canceled", "cleanup-failed", "missing-receipt"]},
    "pass": {"type": "boolean"},
    "claim_eligible": {"type": "boolean"},
    "criterion_pass": {"const": false},
    "capability_promotion": {"const": false},
    "host_model": {"$ref": "#/$defs/publicText"},
    "macos_version": {"$ref": "#/$defs/publicText"},
    "started_at": {"$ref": "#/$defs/timestamp"},
    "finished_at": {"$ref": "#/$defs/timestamp"},
    "hosted_ci_run_id": {"$ref": "#/$defs/publicText"},
    "security_ci_run_id": {"$ref": "#/$defs/publicText"},
    "input_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "app_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "app_executable_sha256": {"$ref": "#/$defs/sha256"},
    "helper_sha256": {"$ref": "#/$defs/sha256"},
    "runner_sha256": {"$ref": "#/$defs/sha256"},
    "firmware_sha256": {"$ref": "#/$defs/sha256"},
    "secure_boot_policy_sha256": {"$ref": "#/$defs/sha256"},
    "iso_sha256": {"$ref": "#/$defs/sha256"},
    "installer_source_sha256": {"$ref": "#/$defs/sha256"},
    "bundled_vars_seed_sha256": {"$ref": "#/$defs/sha256"},
    "final_disk_sha256": {"$ref": "#/$defs/sha256"},
    "final_vars_sha256": {"$ref": "#/$defs/sha256"},
    "secure_boot_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "guest_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_preflight_passes": {"$ref": "#/$defs/count"},
    "vm_created_passes": {"$ref": "#/$defs/count"},
    "source_prepared_passes": {"$ref": "#/$defs/count"},
    "windows_installed_passes": {"$ref": "#/$defs/count"},
    "secure_boot_provisioned_passes": {"$ref": "#/$defs/count"},
    "first_ready_passes": {"$ref": "#/$defs/count"},
    "keyboard_pointer_passes": {"$ref": "#/$defs/count"},
    "clipboard_passes": {"$ref": "#/$defs/count"},
    "folder_share_passes": {"$ref": "#/$defs/count"},
    "network_passes": {"$ref": "#/$defs/count"},
    "audio_passes": {"$ref": "#/$defs/count"},
    "first_shutdown_passes": {"$ref": "#/$defs/count"},
    "snapshot_restore_passes": {"$ref": "#/$defs/count"},
    "second_ready_passes": {"$ref": "#/$defs/count"},
    "second_shutdown_passes": {"$ref": "#/$defs/count"}
  },
  "allOf": [
    {"if": {"properties": {"campaign_mode": {"const": "pilot"}}}, "then": {"properties": {"expected_runs": {"const": 1}}}},
    {"if": {"properties": {"campaign_mode": {"const": "release"}}}, "then": {"properties": {"expected_runs": {"const": 3}}}}
  ]
}
