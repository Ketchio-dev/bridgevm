{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridgevm.dev/schemas/a9-ci-run-attestation-v1.json",
  "title": "BridgeVM A9 GitHub-hosted CI run attestation v1",
  "description": "Written by scripts/fetch-a9-ci-attestation.py from gh api and validated on the JSON alone by scripts/a9_ci_attestation.py. head_sha must be the claimed commit. A Hosted full project check run also records its job's checked_source_sha log line, which must be the same commit; a Security and quality run records 'absent' and must be a push or workflow_dispatch run, which checks out head_sha itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "repository", "workflow_name", "workflow_path", "run_id", "run_attempt",
    "head_sha", "checked_source_sha", "event", "status", "conclusion", "html_url", "fetched_at"
  ],
  "properties": {
    "schema_version": {"const": "bridgevm.a9-ci-run-attestation.v1"},
    "repository": {"const": "Ketchio-dev/bridgevm"},
    "workflow_name": {"enum": ["Hosted full project check", "Security and quality"]},
    "workflow_path": {"enum": [".github/workflows/hosted-full-project-check.yml", ".github/workflows/security-quality.yml"]},
    "run_id": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"},
    "run_attempt": {"type": "integer", "minimum": 1},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "checked_source_sha": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|absent)$"},
    "event": {"enum": ["workflow_dispatch", "push"]},
    "status": {"const": "completed"},
    "conclusion": {"enum": ["success", "failure", "cancelled", "timed_out", "skipped", "neutral", "action_required", "stale", "startup_failure"]},
    "html_url": {"type": "string", "pattern": "^https://github\\.com/Ketchio-dev/bridgevm/actions/runs/[1-9][0-9]{0,19}$"},
    "fetched_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
