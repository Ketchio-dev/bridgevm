{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridgevm.dev/schemas/a9-release-claim-v1.json",
  "title": "BridgeVM combined A9 release-claim receipt v1",
  "description": "Written and verified only by scripts/a9-release-claim.py, a pure function of the bound T17 and T19 receipts, both CI attestations and the optional clean-host attestation. claim_eligible is true exactly when unmet_conditions is empty. criterion_pass and capability_promotion are always false; the capability registry is never written.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "criterion", "commit", "three_d_injection", "host_model", "macos_version",
    "app_artifact_sha256", "app_executable_sha256", "journeys", "ci", "clean_host", "clean_machine",
    "unmet_conditions", "claim_eligible", "criterion_pass", "capability_promotion"
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "journey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_sha256", "job_id", "campaign_mode", "expected_runs", "run_count", "passes", "pass",
                   "artifact_signing_class", "started_at", "finished_at"],
      "properties": {
        "receipt_sha256": {"$ref": "#/$defs/sha256"},
        "job_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "campaign_mode": {"enum": ["pilot", "release"]},
        "expected_runs": {"enum": [1, 3]},
        "run_count": {"type": "integer", "minimum": 0, "maximum": 3},
        "passes": {"type": "integer", "minimum": 0, "maximum": 3},
        "pass": {"type": "boolean"},
        "artifact_signing_class": {"enum": ["unverified", "development-ad-hoc", "development-signed", "developer-id-notarized"]},
        "started_at": {"$ref": "#/$defs/time"},
        "finished_at": {"$ref": "#/$defs/time"}
      }
    },
    "ci_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attestation_sha256", "run_id", "conclusion"],
      "properties": {
        "attestation_sha256": {"$ref": "#/$defs/sha256"},
        "run_id": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"},
        "conclusion": {"enum": ["success", "failure", "cancelled", "timed_out", "skipped", "neutral", "action_required", "stale", "startup_failure"]}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "bridgevm.a9-release-claim.v1"},
    "criterion": {"const": "A9"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "three_d_injection": {"const": false},
    "host_model": {"type": "string", "pattern": "^[^/\\\\\\u0000-\\u001f\\u007f]{1,128}$"},
    "macos_version": {"type": "string", "pattern": "^[^/\\\\\\u0000-\\u001f\\u007f]{1,128}$"},
    "app_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "app_executable_sha256": {"$ref": "#/$defs/sha256"},
    "journeys": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t17", "t19"],
      "properties": {"t17": {"$ref": "#/$defs/journey"}, "t19": {"$ref": "#/$defs/journey"}}
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hosted_full", "security_quality"],
      "properties": {"hosted_full": {"$ref": "#/$defs/ci_run"}, "security_quality": {"$ref": "#/$defs/ci_run"}}
    },
    "clean_host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attestation_sha256", "attested_at"],
      "oneOf": [
        {"properties": {"attestation_sha256": {"const": "absent"}, "attested_at": {"const": "absent"}}},
        {"properties": {"attestation_sha256": {"$ref": "#/$defs/sha256"}, "attested_at": {"$ref": "#/$defs/time"}}}
      ]
    },
    "clean_machine": {"type": "boolean"},
    "unmet_conditions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": [
        "t17-campaign-not-release", "t17-not-three-of-three-passing", "t17-signing-not-developer-id-notarized",
        "t19-campaign-not-release", "t19-not-three-of-three-passing", "t19-signing-not-developer-id-notarized",
        "hosted-full-ci-not-success", "security-quality-ci-not-success", "clean-host-attestation-absent"
      ]}
    },
    "claim_eligible": {"type": "boolean"},
    "criterion_pass": {"const": false},
    "capability_promotion": {"const": false}
  }
}
