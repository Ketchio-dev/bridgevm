{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridgevm.dev/schemas/windows-hvf-import-product-e2e-receipt-v1.json",
  "title": "BridgeVM Windows-HVF installed-disk import product E2E receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "gate_id", "criterion", "tier", "job_id", "tested_commit", "commit",
    "hosted_ci_commit", "campaign_mode", "artifact_signing_class", "clean_machine",
    "ui_frontend_automated", "product_model_automated", "three_d_injection",
    "worker_cleanup_verified", "hosted_ci_green", "security_ci_green", "valid", "expected_runs",
    "run_count", "passes", "failures", "elapsed_ms", "failure_code", "outcome", "pass",
    "claim_eligible", "criterion_pass", "capability_promotion", "host_model", "macos_version",
    "started_at", "finished_at", "hosted_ci_run_id", "security_ci_run_id",
    "input_manifest_sha256", "app_artifact_sha256", "app_executable_sha256", "helper_sha256",
    "runner_sha256", "source_disk_sha256", "source_vars_sha256", "source_vtpm_tree_sha256",
    "imported_initial_disk_sha256", "imported_initial_vars_sha256", "imported_initial_vtpm_tree_sha256",
    "final_disk_sha256", "final_vars_sha256", "final_vtpm_tree_sha256", "guest_evidence_sha256",
    "artifact_preflight_passes", "source_authenticated_passes", "ui_imported_passes",
    "imported_media_authenticated_passes", "first_ready_passes", "keyboard_pointer_passes",
    "clipboard_passes", "folder_share_passes", "network_passes", "audio_passes",
    "first_shutdown_passes", "snapshot_restore_passes", "second_ready_passes", "second_shutdown_passes"
  ],
  "$defs": {
    "sha256": {"oneOf": [{"const": "absent"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "count": {"type": "integer", "minimum": 0},
    "text": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$"},
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  },
  "properties": {
    "schema_version": {"const": "bridgevm.windows-hvf-import-product-e2e.v1"},
    "gate_id": {"const": "windows-hvf-installed-disk-import-e2e"},
    "criterion": {"const": "A9"},
    "tier": {"const": "t19-windows-hvf-import-product-e2e"},
    "job_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "tested_commit": {"$ref": "#/$defs/commit"}, "commit": {"$ref": "#/$defs/commit"},
    "hosted_ci_commit": {"$ref": "#/$defs/commit"}, "campaign_mode": {"enum": ["pilot", "release"]},
    "artifact_signing_class": {"enum": ["unverified", "development-ad-hoc", "development-signed", "developer-id-notarized"]},
    "clean_machine": {"type": "boolean"}, "ui_frontend_automated": {"type": "boolean"},
    "product_model_automated": {"type": "boolean"}, "three_d_injection": {"const": false},
    "worker_cleanup_verified": {"type": "boolean"}, "hosted_ci_green": {"type": "boolean"},
    "security_ci_green": {"type": "boolean"}, "valid": {"type": "boolean"},
    "expected_runs": {"enum": [1, 3]}, "run_count": {"$ref": "#/$defs/count"},
    "passes": {"$ref": "#/$defs/count"}, "failures": {"$ref": "#/$defs/count"},
    "elapsed_ms": {"$ref": "#/$defs/count"},
    "failure_code": {"enum": ["none", "missing-app-artifact", "missing-installed-disk", "missing-vars", "missing-vtpm", "invalid-vars", "hash-mismatch", "product-model-failed", "first-boot-failed", "integration-failed", "snapshot-failed", "cleanup-failed", "canceled", "missing-tier-receipt", "internal-error"]},
    "outcome": {"enum": ["completed", "preflight-blocked", "failed", "canceled", "cleanup-failed", "missing-receipt"]},
    "pass": {"type": "boolean"}, "claim_eligible": {"const": false}, "criterion_pass": {"const": false},
    "capability_promotion": {"const": false}, "host_model": {"$ref": "#/$defs/text"},
    "macos_version": {"$ref": "#/$defs/text"}, "started_at": {"$ref": "#/$defs/time"},
    "finished_at": {"$ref": "#/$defs/time"}, "hosted_ci_run_id": {"$ref": "#/$defs/text"},
    "security_ci_run_id": {"$ref": "#/$defs/text"},
    "input_manifest_sha256": {"$ref": "#/$defs/sha256"}, "app_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "app_executable_sha256": {"$ref": "#/$defs/sha256"}, "helper_sha256": {"$ref": "#/$defs/sha256"},
    "runner_sha256": {"$ref": "#/$defs/sha256"}, "source_disk_sha256": {"$ref": "#/$defs/sha256"},
    "source_vars_sha256": {"$ref": "#/$defs/sha256"}, "source_vtpm_tree_sha256": {"$ref": "#/$defs/sha256"},
    "imported_initial_disk_sha256": {"$ref": "#/$defs/sha256"}, "imported_initial_vars_sha256": {"$ref": "#/$defs/sha256"},
    "imported_initial_vtpm_tree_sha256": {"$ref": "#/$defs/sha256"}, "final_disk_sha256": {"$ref": "#/$defs/sha256"},
    "final_vars_sha256": {"$ref": "#/$defs/sha256"}, "final_vtpm_tree_sha256": {"$ref": "#/$defs/sha256"},
    "guest_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_preflight_passes": {"$ref": "#/$defs/count"}, "source_authenticated_passes": {"$ref": "#/$defs/count"},
    "ui_imported_passes": {"$ref": "#/$defs/count"}, "imported_media_authenticated_passes": {"$ref": "#/$defs/count"},
    "first_ready_passes": {"$ref": "#/$defs/count"}, "keyboard_pointer_passes": {"$ref": "#/$defs/count"},
    "clipboard_passes": {"$ref": "#/$defs/count"}, "folder_share_passes": {"$ref": "#/$defs/count"},
    "network_passes": {"$ref": "#/$defs/count"}, "audio_passes": {"$ref": "#/$defs/count"},
    "first_shutdown_passes": {"$ref": "#/$defs/count"}, "snapshot_restore_passes": {"$ref": "#/$defs/count"},
    "second_ready_passes": {"$ref": "#/$defs/count"}, "second_shutdown_passes": {"$ref": "#/$defs/count"}
  }
}
