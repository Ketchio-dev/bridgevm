+static void
+bridgevm_trace_alloc_list_grow_failure(struct virgl_gdi_cmd_buf *cbuf,
+                                       struct virgl_hw_res *res)
+{
+   InterlockedExchange(&bridgevm_trace_grow_failed, 1);
+   static volatile LONG emitted;
+   if (InterlockedIncrement(&emitted) > 32)
+      return;
+   char message[160];
+   snprintf(message, sizeof(message),
+            "BV-VIRGL-ALLOC-LIST-GROW-FAIL alloc_count=%d max_alloc=%u res_id=%u\n",
+            cbuf->alloc_count, cbuf->max_alloc, res->res_handle);
+   OutputDebugStringA(message);
+}
