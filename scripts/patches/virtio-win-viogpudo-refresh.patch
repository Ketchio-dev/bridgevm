new file mode 100644
index 0000000..5f11099
--- /dev/null
+++ b/viogpu/viogpudo/bridgevm_refresh.h
@@ -0,0 +1,14 @@
+#pragma once
+
+// Integer-Hz virtual raster. A retrace interrupt marks the START of blanking,
+// so phase zero is line activeLines, not the first visible scan line.
+inline unsigned int BridgeVmRefreshRasterLine(unsigned long long elapsedTicks,
+                                              unsigned long long ticksPerSecond,
+                                              unsigned int hz,
+                                              unsigned int activeLines)
+{
+    const unsigned long long phase = ((elapsedTicks % ticksPerSecond) * hz) % ticksPerSecond;
+    const unsigned int totalLines = activeLines + 20;
+    const unsigned int linesAfterRetrace = static_cast<unsigned int>(phase * totalLines / ticksPerSecond);
+    return (activeLines + linesAfterRetrace) % totalLines;
+}
