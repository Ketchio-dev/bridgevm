+}
+
+NTSTATUS VioGpuAdapter::ControlVsync(BOOLEAN enabled)
+{
+    PAGED_CODE();
+    KeAcquireGuardedMutex(&m_RefreshMutex);
+    InterlockedExchange(&m_VsyncEnabled, enabled ? 1 : 0);
+    InterlockedExchange64(&m_LastVsyncQpc, KeQueryPerformanceCounter(NULL).QuadPart);
+    ApplyVsync();
+    KeReleaseGuardedMutex(&m_RefreshMutex);
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS VioGpuAdapter::SetRefreshTiming(const D3DKMDT_VIDEO_SIGNAL_INFO &signal)
+{
+    PAGED_CODE();
+    // Only advertise and commit the same preset set. No silent rounding of a
+    // pinned mode into another rate, and no zero/overflow in raster arithmetic.
+    const ULONG hz = signal.VSyncFreq.Numerator;
+    BOOLEAN supported = FALSE;
+    for (UINT i = 0; i < g_BridgeRefreshRateCount; ++i)
+    {
+        supported |= g_BridgeRefreshRates[i] == hz;
+    }
+    if (!supported || signal.VSyncFreq.Denominator != 1 || signal.ActiveSize.cy == 0 || signal.ActiveSize.cy > 16384)
+    {
+        return STATUS_GRAPHICS_INVALID_VIDPN_TARGETMODESET;
+    }
+    KeAcquireGuardedMutex(&m_RefreshMutex);
+    InterlockedExchange(&m_RefreshHz, LONG(hz));
+    InterlockedExchange(&m_ActiveLines, LONG(signal.ActiveSize.cy));
+    InterlockedExchange64(&m_LastVsyncQpc, KeQueryPerformanceCounter(NULL).QuadPart);
+    ApplyVsync();
+    KeReleaseGuardedMutex(&m_RefreshMutex);
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS VioGpuAdapter::GetScanLine(DXGKARG_GETSCANLINE *line)
+{
+    PAGED_CODE();
+    if (line->VidPnTargetId != 0) { return STATUS_INVALID_PARAMETER; }
+    if (!m_pVioGpuDod->IsHardwareInit()) { return STATUS_DEVICE_NOT_READY; }
+    LARGE_INTEGER frequency;
+    const LONGLONG now = KeQueryPerformanceCounter(&frequency).QuadPart;
+    const LONGLONG last = InterlockedCompareExchange64(&m_LastVsyncQpc, 0, 0);
+    const ULONGLONG elapsed = now >= last ? ULONGLONG(now - last) : 0;
+    const ULONG hz = InterlockedCompareExchange(&m_RefreshHz, 0, 0);
+    const ULONG active = InterlockedCompareExchange(&m_ActiveLines, 0, 0);
+    const ULONG raster = BridgeVmRefreshRasterLine(elapsed, frequency.QuadPart, hz, active);
+    line->InVerticalBlank = raster >= active;
+    line->ScanLine = line->InVerticalBlank ? 0 : raster;
+    return STATUS_SUCCESS;
+}
+
 PAGED_CODE_SEG_END

+void VioGpuAdapter::ApplyVsync()
+{
+    if (!m_pVioGpuDod->IsHardwareInit()) { return; }
+    ULONG hz = InterlockedCompareExchange(&m_RefreshHz, 0, 0);
+    ULONG enabled = InterlockedCompareExchange(&m_VsyncEnabled, 0, 0);
+    virtio_set_config(&m_VioDev, 20, &hz, sizeof(hz));
+    virtio_set_config(&m_VioDev, 24, &enabled, sizeof(enabled));
+}
