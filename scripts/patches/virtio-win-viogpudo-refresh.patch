+// VidPN enumeration does not automatically refresh the connected monitor's
+// retained timing set when GET_DISPLAY_INFO replaces the custom geometry.
+// Update that set in the documented enumeration callback context, without
+// disconnecting the display or restarting its adapter.
+NTSTATUS VioGpuDod::UpdateConnectedMonitorModes(D3DDDI_VIDEO_PRESENT_TARGET_ID targetId)
+{
+    PAGED_CODE();
+    const DXGK_MONITOR_INTERFACE *monitor = NULL;
+    NTSTATUS status = m_DxgkInterface.DxgkCbQueryMonitorInterface(m_DxgkInterface.DeviceHandle,
+                                                                  DXGK_MONITOR_INTERFACE_VERSION_V1,
+                                                                  &monitor);
+    if (!NT_SUCCESS(status)) { return status; }
+    if (!monitor || monitor->Version != DXGK_MONITOR_INTERFACE_VERSION_V1) { return STATUS_NOT_SUPPORTED; }
+
+    DXGKARG_RECOMMENDMONITORMODES modes = {};
+    modes.VideoPresentTargetId = targetId;
+    status = monitor->pfnAcquireMonitorSourceModeSet(m_DxgkInterface.DeviceHandle,
+                                                       targetId,
+                                                       &modes.hMonitorSourceModeSet,
+                                                       &modes.pMonitorSourceModeSetInterface);
+    if (!NT_SUCCESS(status)) { return status; }
+    status = AddSingleMonitorMode(&modes);
+    const NTSTATUS releaseStatus = monitor->pfnReleaseMonitorSourceModeSet(m_DxgkInterface.DeviceHandle,
+                                                                            modes.hMonitorSourceModeSet);
+    return NT_SUCCESS(status) ? releaseStatus : status;
+}
