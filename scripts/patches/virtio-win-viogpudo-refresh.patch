+NTSTATUS VioGpuDod::ControlInterrupt(DXGK_INTERRUPT_TYPE type, BOOLEAN enabled)
+{
+    PAGED_CODE();
+    if (type != DXGK_INTERRUPT_DISPLAYONLY_VSYNC && type != DXGK_INTERRUPT_CRTC_VSYNC) { return STATUS_NOT_IMPLEMENTED; }
+    return m_pHWDevice ? m_pHWDevice->ControlVsync(enabled) : STATUS_DEVICE_NOT_READY;
+}
